OPENAI_API_KEY=your-openai-api-key

# Optional Amy settings
# AMY_MODEL=gpt-4.1-mini
# AMY_ASSISTANT_NAME=Amy
# AMY_CONTEXT_PATH=config/project_context.md
# AMY_MEMORY_DIR=src/agents/amy/memory
# AMY_RECENT_TURNS=6
# AMY_WAKE_WORD=amy
# AMY_TRANSCRIPT_LANGUAGE=
# AMY_TRANSCRIPTION_MODEL=mlx-community/whisper-large-v3-turbo
# AMY_WAKE_MODEL=mlx-community/whisper-tiny
# AMY_RING_BUFFER_MS=2000
# AMY_WAKE_WINDOW_MS=1200
# AMY_WAKE_MIN_WINDOW_MS=500
# AMY_WAKE_POLL_MS=300
# Lower this if the wake word is missed on a quiet mic; raise it if noise triggers Amy.
# AMY_RMS_THRESHOLD=500
# Wake detection uses a higher gate so idle room noise does not invoke Whisper.
# AMY_WAKE_RMS_THRESHOLD=650
# AMY_SILENCE_MS=700
# AMY_LOG_TRANSCRIPTS=false
# AMY_AUDIO_INPUT_DEVICE=Audient iD24
